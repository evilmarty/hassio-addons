{
  "name": "Layerling",
  "version": "1.136.0",
  "slug": "layerling",
  "description": "Easy 3D CAD for 3D printing, in your browser",
  "url": "https://github.com/evilmarty/hassio-addons/tree/master/layerling",
  "image": "ghcr.io/evilmarty/hassio-layerling",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "application",
  "init": false,
  "webui": "http://[HOST]:[PORT:3000]",
  "watchdog": "http://[HOST]:[PORT:3000]",
  "ports": {
    "3000/tcp": 3000
  },
  "ports_description": {
    "3000/tcp": "The port used to serve the application"
  },
  "options": {
    "default_theme": "system",
    "simple_mode": "false",
    "new_designs_on_server": "always"
  },
  "schema": {
    "default_theme": "list(system|light|dark|graphite)",
    "simple_mode": "list(false|true|always)",
    "new_designs_on_server": "list(false|true|always)",
    "allowed_origins": "str?",
    "user_header": "str?",
    "mcp_remote": "bool?",
    "mcp_token": "password?",
    "mcp_allowed_hosts": "str?"
  }
}
